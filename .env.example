# Passe Livre Suzano — Configurações de Ambiente
APP_ENV=development
# Origem permitida para CORS (ex.: http://localhost/teste4.4/teste4). Vazio = sem cabeçalho CORS.
APP_URL=

# Conexão com o Banco de Dados MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=passe_livre_suzano
DB_USER=root
DB_PASS=

# ---------------------------------------------------------------------------
# Login com Google (Google Identity Services)
# Client ID OAuth do tipo "Aplicativo da Web" (Google Cloud Console > APIs e
# serviços > Credenciais > ID do cliente OAuth).
# Vazio = botão "Continuar com Google" oculto e API responde 503.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Proxies de APIs externas (deixe vazio para manter o comportamento estático)
# ---------------------------------------------------------------------------
# Provedor de busca de enderecos: nominatim | geoapify
GEOCODER_PROVIDER=nominatim
# Chave da Geoapify (https://www.geoapify.com/get-an-api-key) — obrigatoria so se GEOCODER_PROVIDER=geoapify
GEOAPIFY_KEY=
# Chave do OpenRouteService (https://openrouteservice.org/dev/#/api-key) — necessária para rota real a pé / cadeira de rodas
ORS_API_KEY=
# Endpoint da Overpass API usado pelos pontos de acessibilidade do mapa
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ---------------------------------------------------------------------------
# SMTP para envio REAL de codigo de verificacao e recuperacao de senha
# MAIL_HOST vazio = e-mails sao ignorados (modo dev sem email)
#
# --- Gmail (App Password) ---
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=seuemail@gmail.com
# MAIL_PASS=xxxx xxxx xxxx xxxx   <- gere em: myaccount.google.com/apppasswords
# MAIL_FROM=seuemail@gmail.com
#
# --- Outlook / Hotmail ---
# MAIL_HOST=smtp-mail.outlook.com
# MAIL_PORT=587
# MAIL_USER=seuemail@outlook.com
# MAIL_PASS=sua_senha
# MAIL_FROM=seuemail@outlook.com
#
# --- Brevo (antigo Sendinblue) — recomendado para producao ---
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USER=seuemail@dominio.com
# MAIL_PASS=sua_chave_smtp_brevo    <- em: app.brevo.com > SMTP & API
# MAIL_FROM=noreply@seudominio.com
#
# --- Hostinger / cPanel / servidor proprio ---
# MAIL_HOST=mail.seudominio.com.br
# MAIL_PORT=587                     <- ou 465 para SSL direto
# MAIL_USER=noreply@seudominio.com.br
# MAIL_PASS=sua_senha_de_email
# MAIL_FROM=noreply@seudominio.com.br
# ---------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# Opcional: caminho para um arquivo PEM com as autoridades certificadoras confiaveis do servidor SMTP.
# Use quando a CA do certificado SMTP nao estiver no bundle do PHP/XAMPP. Nunca desative a verificacao TLS.
MAIL_CA_FILE=

# Segredo interno do endpoint api/mail-send.php (mínimo 32 bytes).
# Gere com: php -r "echo bin2hex(random_bytes(32));"
# Vazio = envio síncrono e endpoint interno bloqueado (403).
MAIL_INTERNAL_SECRET=
